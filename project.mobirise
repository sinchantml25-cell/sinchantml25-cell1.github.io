            ".mbr-text, .item .mbr-section-btn": {
              "text-align": "left"
            },
            ".item-wrapper": {
              "background": "@cardbg",
              "margin-bottom": "2rem",
              "@media (max-width: 767px)": {
                "padding": "2rem 1.5rem",
                "margin-bottom": "1rem"
              },
              "@media (min-width: 768px) and (max-width: 991px)": {
                "padding": "2.25rem"
              },
              "@media (min-width: 992px)": {
                "padding": "4rem"
              }
            },
            ".details-icon": {
              "color": "@iconColor",
              "padding-right": "0.5rem"
            },
            ".mbr-card-subtitle": {
              "color": "#ff9f9f",
              "text-align": "left"
            },
            ".details": {
              ".details-item": {
                "display": "inline-flex",
                "padding-right": "1rem"
              }
            },
            ".mbr-tag, .tags-wrapper": {
              "color": "#000000"
            },
            ".mbr-card-subtitle DIV": {
              "text-align": "center"
            },
            ".mbr-card-subtitle P": {
